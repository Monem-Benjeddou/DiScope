<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.1</Version>
    <Authors>DiScope contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Monem-Benjeddou/DiScope</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Monem-Benjeddou/DiScope.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/Monem-Benjeddou/DiScope/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <Copyright>Copyright (c) DiScope contributors</Copyright>
  </PropertyGroup>
</Project>
