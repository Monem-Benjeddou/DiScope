<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The agent runs INSIDE the analyzed app's process (launched with the app's runtimeconfig.json),
    so it must only depend on the BCL. Everything DI-related is accessed through reflection.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <UseAppHost>false</UseAppHost>
    <DefineConstants>$(DefineConstants);DISCOPE_AGENT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
