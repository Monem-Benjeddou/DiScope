<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>discope</AssemblyName>
    <RootNamespace>DiScope.Cli</RootNamespace>
    <RollForward>Major</RollForward>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>discope</ToolCommandName>
    <PackageId>DiScope</PackageId>
    <Description>See your .NET dependency injection graph. Finds captive dependencies, missing registrations, cycles and more in the real IServiceCollection of your app.</Description>
    <PackageTags>dependency-injection;di;ioc;aspnetcore;analyzer;graph;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiScope.Core\DiScope.Core.csproj" />
    <!-- Build the agent first, but don't reference it: it only ever runs inside the analyzed app's process. -->
    <ProjectReference Include="..\DiScope.Agent\DiScope.Agent.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\DiScope.Agent\bin\$(Configuration)\net8.0\DiScope.Agent.dll" Link="agent\DiScope.Agent.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\editors\vscode\media\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DiScope.IntegrationTests" />
  </ItemGroup>

</Project>
